meta {
  name: Get Medici Report
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/integration/fijiAspenMediciReport
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  X-Tamanu-Client: bruno
  X-Version: 1.0.0
}

params:query {
  ~period.start: 2024-01-01T00:00:00
  ~period.end: 2024-01-01T01:00:00
  ~encounters:
  ~limit: 100
  ~offset: 0
  ~discharge_date:
}
