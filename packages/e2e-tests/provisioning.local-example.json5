// Example central-server provisioning for local e2e runs — mirrors the file CI writes in
// .github/scripts/e2e-test-setup.sh. Copy to packages/central-server/provisioning.json5
// (gitignored) and adjust if needed; see packages/e2e-tests/README.md.
{
  users: {
    "admin@tamanu.io": {
      role: "admin",
      password: "admin",
      displayName: "Initial Admin",
    },
    "practitioner@tamanu.io": {
      role: "practitioner",
      password: "practitioner",
      displayName: "Test Practitioner",
    },
    "reception@tamanu.io": {
      role: "reception",
      password: "reception",
      displayName: "Test Reception",
    },
  },

  facilities: {
    "facility-1": {
      name: "facility-1",
      code: "facility-1",
      user: "facility-1@tamanu.io",
      password: "facility-1",
    },
  },

  settings: {
    global: {
      features: {
        deviceRegistrationQuota: {
          enabled: false,
        },
        desktopCharting: {
          enabled: true,
        },
        enableTasking: true,
        patientPortal: true,
        invoicing: {
          enabled: true,
        },
      },
      experimentalAi: {
        enabled: true,
        patientSummary: {
          enabled: true,
        },
        encounterSummary: {
          enabled: true,
        },
      },
      medications: {
        dispensing: {
          // Auto-calculate the dispensing quantity from dose, frequency and duration when
          // prescribing (exercised by the medication prescribe e2e spec).
          dispensingQuantityAutocalculation: true,
        },
      },
      // Playwright's bundled Chromium lags the latest Chrome major, which the support floor
      // tracks; at the default the suite lands on the browser-unsupported page.
      browserSupport: {
        versionsBack: 12,
      },
    },
    central: {
      mail: {
        // Patient portal sign-in emails a code; the JSON transport accepts the email and delivers
        // nothing, and the portal specs issue the code themselves (utils/centralDatabase.ts).
        from: "tamanu-e2e@tamanu.io",
        transport: {
          jsonTransport: true,
        },
      },
    },
    facilities: {
      "facility-1": {
        kiosk: {
          enabled: true,
        },
      },
    },
  },

  referenceData: [
    {
      defaultSpreadsheet: true,
    },
  ],

  programs: [
    {
      url: 'https://bes-tamanu-dev-referencedata.s3.ap-southeast-2.amazonaws.com/programs/vitals.xlsx',
    },
    {
      url: 'https://bes-tamanu-dev-referencedata.s3.ap-southeast-2.amazonaws.com/programs/neurological-assessment.xlsx',
    },
    {
      url: 'https://bes-tamanu-dev-referencedata.s3.ap-southeast-2.amazonaws.com/programs/ncd-primary-screening.xlsx',
    },
  ],
}
