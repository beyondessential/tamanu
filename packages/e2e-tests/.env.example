# The URL of the facility frontend
# e.g. 'https://facility-2.release-2-26.internal.tamanu.io/' or 'http://localhost:5173' etc
FACILITY_FRONTEND_URL='http://localhost:5173'

# The URL of the admin panel frontend
# e.g. 'https://central.release-2-26.internal.tamanu.io/' or 'http://localhost:5174' etc
ADMIN_FRONTEND_URL='http://localhost:5174'

# The URL of the patient portal frontend
PATIENT_PORTAL_URL='http://localhost:5175'

# The central server's database, where patient portal specs arrange their patients
# e.g. 'postgres://tamanu:tamanu@localhost:5432/central' (CI's) or 'postgres:///tamanu-e2e-central'
CENTRAL_DATABASE_URL='postgres://tamanu:tamanu@localhost:5432/central'

# If true, local servers will be launched automatically as defined in playwright.config.ts
LAUNCH_LOCAL_SERVERS_WHEN_RUNNING_TESTS=true

# User credentials for E2E tests to login to Tamanu
TEST_EMAIL=
TEST_PASSWORD=

#The timezone for running tests. CI uses 'Pacific/Auckland' but use whatever your local timezone is
TZ='Pacific/Auckland'
