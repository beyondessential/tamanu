{
  "extends": "../../common.tsconfig.json",
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "types": ["jest"],
    "erasableSyntaxOnly": false,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "isolatedModules": false,
    "baseUrl": ".",
    "paths": {
      "~/*": ["App/*"],
      "/root/*": ["./*"],
      "/components/*": ["App/ui/components/*"],
      "/styled/*": ["App/ui/styled/*"],
      "/interfaces/*": ["App/ui/interfaces/*"],
      "/helpers/*": ["App/ui/helpers/*"],
      "/types/*": ["App/types/*"],
      "/navigation/*": ["App/ui/navigation/*"],
      "/containers/*": ["App/ui/containers/*"],
      "/contexts/*": ["App/ui/contexts/*"],
      "/store/*": ["App/ui/store/*"],
      "/models/*": ["App/ui/models/*"],
      "/services/*": ["App/ui/services/*"],
      "/domain/*": ["App/domain/*"],
      "/data/*": ["App/data/*"],
      "/infra/*": ["App/infra/*"],
      "/presentation/*": ["App/presentation/*"],
      "/migrations/*": ["App/migrations/*"]
    },
    "moduleResolution": "bundler",
    "customConditions": ["react-native"],
    "resolveJsonModule": true,
    "jsx": "react",
    "lib": [
      "es2019",
      "es2020.bigint",
      "es2020.date",
      "es2020.number",
      "es2020.promise",
      "es2020.string",
      "es2020.symbol.wellknown",
      "es2021.promise",
      "es2021.string",
      "es2021.weakref",
      "es2022.array",
      "es2022.object",
      "es2022.string"
    ],
    "skipLibCheck": true,
    "strict": false,
    "noImplicitThis": false
  },
  "exclude": ["node_modules", "babel.config.js", "metro.config.js", "jest.config.mjs"]
}
