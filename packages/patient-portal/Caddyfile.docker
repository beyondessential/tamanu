# BIND_ADDRESS is a comma-separated list of host:port listeners (IPv4 or
# bracketed IPv6, e.g. "127.0.0.1:3000,[::1]:3000"); defaults to :3000.
{$BIND_ADDRESS::3000} {
	root * /app
	log {
		output stderr
	}

	encode zstd gzip
	file_server {
		precompressed zstd br gzip
	}

	header / Cache-Control no-cache
	header /manifest.json Cache-Control no-cache
	header /env.js {
		Cache-Control no-cache
		Content-Type "text/javascript; charset=utf-8"
	}

	# SPA fallback, spelled out from try_files so it can leave /env.js alone:
	# rewrites run before respond, so it would otherwise become /index.html.
	@spa {
		not path /env.js
		file {path} {path}/ /index.html
	}
	rewrite @spa {file_match.relative}

	handle_errors {
		@custom_err file /resources/errors/{err.status_code}.html
		handle @custom_err {
			rewrite * {file_match.relative}
			file_server
		}
	}

	respond /env.js <<JS
		window.env = {
			NODE_ENV: `{$NODE_ENV}` || 'production',
			BUGSNAG_API_KEY: `{$BUGSNAG_API_KEY}` || null,
			REVISION: `{$REVISION}` || null,
		}
		JS 200
}
