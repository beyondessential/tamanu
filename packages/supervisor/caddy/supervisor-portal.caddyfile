# The supervisor's routing on a central server with a patient portal: the
# server's, and the portal's own address. Its api paths still go to the api.
#
# spec: SUPV#front-door

import supervisor.caddyfile

http://:{$_TAMANU_SUPERVISOR_PORTAL_PORT} {
	bind {$TAMANU_SUPERVISOR_PORTAL_LISTEN}
	import front {$TAMANU_SUPERVISOR_PORTAL_ROOT}
}
